{
  "name": "apex-formula-laboratory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original instrumented Formula racing simulation in TypeScript and Three.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:physics": "node --experimental-transform-types scripts/validate.ts && npm run test:dynamics && npm run test:race-control && npm run test:wet-pits && npm run test:journey",
    "test:endurance": "node --experimental-transform-types scripts/endurance.ts",
    "test:e2e": "playwright test",
    "lint": "eslint src tests e2e scripts",
    "format": "prettier --write src tests e2e scripts *.json *.ts *.html",
    "check": "npm run lint && npm run validate:content && npm test && npm run build",
    "validate:content": "node --experimental-transform-types scripts/validate-content.ts",
    "test:vehicles": "node --experimental-transform-types scripts/vehicle-calibration.ts",
    "test:catalogue-races": "node --experimental-transform-types scripts/catalogue-races.ts",
    "test:bikes": "node --experimental-transform-types scripts/bike-race.ts",
    "test:offroad": "node --experimental-transform-types scripts/offroad-calibration.ts && node --experimental-transform-types scripts/offroad-races.ts",
    "test:server": "node --experimental-transform-types scripts/server-prototype.ts",
    "test:online": "node --experimental-transform-types scripts/online-slice.ts",
    "test:long-session": "node --expose-gc --experimental-transform-types scripts/long-session.ts",
    "test:dynamics": "node --experimental-transform-types scripts/dynamics-benchmark.ts",
    "test:race-control": "node --experimental-transform-types scripts/marshal-integration.ts",
    "test:performance": "node --experimental-transform-types scripts/performance-compare.ts",
    "test:weather": "node --experimental-transform-types scripts/weather-selftest.ts",
    "test:wet-pits": "node --experimental-transform-types scripts/wet-pit-integration.ts",
    "test:journey": "node --experimental-transform-types scripts/integrated-driving.ts",
    "test:reference-ui": "node scripts/reference-ui-check.mjs",
    "test:phase27c": "node --experimental-transform-types scripts/phase27c-verify.ts",
    "test:open-world": "node --experimental-transform-types scripts/open-world.ts",
    "generate:player-lods": "node --experimental-strip-types scripts/build-player-lods.mjs",
    "prebuild": "npm run generate:player-lods",
    "predev": "npm run generate:player-lods",
    "pretest": "npm run generate:player-lods",
    "test:e2e:shard": "node --experimental-strip-types scripts/run-browser-shard.ts",
    "check:stable": "node --experimental-transform-types scripts/source-stability.ts -- npm run check"
  },
  "dependencies": {
    "@fontsource-variable/saira": "5.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/three": "0.180.0",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "meshoptimizer": "0.25.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
